<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.jotrorox.verilogtoolbox</id>
    <name>Verilog Toolbox</name>
    <vendor>Jotrorox</vendor>

    <description><![CDATA[
        Verilog and SystemVerilog support for CLion: code insight from the slang-server language server,
        which is downloaded automatically, plus Icarus Verilog and GTKWave integration.
        ]]></description>

    <!-- Platform module for the base APIs; LSP module for the Verible and slang language servers. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>

        <fileType name="Verilog" language="Verilog" extensions="v;vh;sv;svh" fieldName="INSTANCE"
                  implementationClass="com.jotrorox.verilogtoolbox.VerilogFileType"/>

        <lang.parserDefinition language="Verilog"
                               implementationClass="com.jotrorox.verilogtoolbox.VerilogParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Verilog"
                                       implementationClass="com.jotrorox.verilogtoolbox.VerilogSyntaxHighlighterFactory"/>
        <annotator language="Verilog"
                   implementationClass="com.jotrorox.verilogtoolbox.VerilogDeclarationAnnotator"/>
        <colorSettingsPage implementation="com.jotrorox.verilogtoolbox.VerilogColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/VerilogDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/VerilogDarcula.xml"/>
        <lang.commenter language="Verilog"
                        implementationClass="com.jotrorox.verilogtoolbox.VerilogCommenter"/>
        <lang.braceMatcher language="Verilog"
                           implementationClass="com.jotrorox.verilogtoolbox.VerilogBraceMatcher"/>
        <lang.quoteHandler language="Verilog"
                           implementationClass="com.jotrorox.verilogtoolbox.VerilogQuoteHandler"/>

        <!-- slang-server: the default language server, downloaded when it is missing. -->
        <platform.lsp.integrationProvider
                implementation="com.jotrorox.verilogtoolbox.SlangLspIntegrationProvider"/>
        <!-- Verible language server: optional second server for formatting and style lint. -->
        <platform.lsp.integrationProvider
                implementation="com.jotrorox.verilogtoolbox.VeribleLspIntegrationProvider"/>
        <applicationConfigurable parentId="tools" id="com.jotrorox.verilogtoolbox.settings"
                                 displayName="Verilog Toolbox"
                                 instance="com.jotrorox.verilogtoolbox.VeribleConfigurable"/>
        <editorNotificationProvider
                implementation="com.jotrorox.verilogtoolbox.LanguageServerNotificationProvider"/>
        <notificationGroup id="Verilog Toolbox" displayType="BALLOON"/>

        <!-- Icarus Verilog: compile a testbench with iverilog and simulate it with vvp. -->
        <configurationType implementation="com.jotrorox.verilogtoolbox.IcarusConfigurationType"/>
        <runConfigurationProducer
                implementation="com.jotrorox.verilogtoolbox.IcarusRunConfigurationProducer"/>
        <runLineMarkerContributor language="Verilog"
                                  implementationClass="com.jotrorox.verilogtoolbox.IcarusRunLineMarkerContributor"/>
    </extensions>

    <actions>
        <!-- The design slang-server elaborates: a top-level file or a build (.f) file. -->
        <action id="VerilogToolbox.SlangSelectDesign"
                class="com.jotrorox.verilogtoolbox.SlangSelectDesignAction"
                text="Set as slang-server Top Level"
                description="Make slang-server elaborate the design below this file, or the files this build file lists">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="VerilogToolbox.SlangClearDesign"
                class="com.jotrorox.verilogtoolbox.SlangClearDesignAction"
                text="Clear slang-server Top Level"
                description="Make slang-server check every file on its own again">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
