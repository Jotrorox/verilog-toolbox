<!-- Quartus Prime: its Tcl files, run configurations, tool window and actions. Included by plugin.xml. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Quartus Tcl: settings (.qsf, .qpf, .qip), constraints (.sdc) and reports. -->
        <fileType name="Quartus Settings" language="QuartusTcl" extensions="qsf;qpf;qip;qdf" fieldName="INSTANCE"
                  implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclSettingsFileType"/>
        <!-- Secondary to the settings type, which keeps the language association; so no language attribute. -->
        <fileType name="SDC Constraints" extensions="sdc" fieldName="INSTANCE"
                  implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclSdcFileType"/>
        <!-- Quartus's text reports open as plain text; patterns, so that other .rpt and .summary files stay unclaimed. -->
        <fileType name="Quartus Report" fieldName="INSTANCE"
                  implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclReportFileType"
                  patterns="*.map.rpt;*.syn.rpt;*.fit.rpt;*.asm.rpt;*.sta.rpt;*.flow.rpt;*.eda.rpt;*.pow.rpt;*.drc.rpt;*.pgm.rpt;*.map.summary;*.syn.summary;*.fit.summary;*.sta.summary;*.pow.summary;*.map.smsg;*.fit.smsg;*.sta.smsg;*.pin"/>
        <lang.parserDefinition language="QuartusTcl"
                               implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclParserDefinition"/>
        <lang.syntaxHighlighterFactory language="QuartusTcl"
                                       implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclColorSettingsPage"/>
        <lang.commenter language="QuartusTcl"
                        implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclCommenter"/>
        <lang.braceMatcher language="QuartusTcl"
                           implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclBraceMatcher"/>
        <lang.quoteHandler language="QuartusTcl"
                           implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclQuoteHandler"/>
        <completion.contributor language="QuartusTcl"
                                implementationClass="com.jotrorox.verilogtoolbox.quartus.tcl.QuartusTclCompletionContributor"/>
        <!-- Quartus Prime: compile the project found in the IDE project, program its device, read its settings. -->
        <configurationType implementation="com.jotrorox.verilogtoolbox.quartus.QuartusConfigurationType"/>
        <runConfigurationProducer
                implementation="com.jotrorox.verilogtoolbox.quartus.QuartusRunConfigurationProducer"/>
        <postStartupActivity implementation="com.jotrorox.verilogtoolbox.quartus.QuartusStartupActivity"/>
        <toolWindow id="Quartus" anchor="right" icon="/icons/quartusToolWindow.svg" canCloseContents="false"
                    factoryClass="com.jotrorox.verilogtoolbox.quartus.QuartusToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- Quartus Prime: what its window is opened for, from compiling to programming the device. -->
        <group id="VerilogToolbox.Quartus" text="Quartus Prime" popup="true" icon="/icons/quartus.svg"
               description="Compile the Quartus Prime project, program its device and change its settings">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="VerilogToolbox.Quartus.NewProject"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusNewProjectAction"
                    text="New Quartus Project…"
                    description="Create a Quartus Prime project (.qpf and .qsf) for a device, with the Verilog sources of this project"
                    icon="AllIcons.General.Add"/>
            <separator/>
            <action id="VerilogToolbox.Quartus.Analyze"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusAnalyzeAction"
                    text="Analysis &amp;&amp; Elaboration"
                    description="Check the design for errors with Quartus Prime, without synthesizing it"
                    icon="AllIcons.Actions.Checked"/>
            <action id="VerilogToolbox.Quartus.Compile"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusCompileAction"
                    text="Compile Design"
                    description="Synthesize, fit, assemble and analyze the timing of the Quartus Prime project"
                    icon="AllIcons.Actions.Compile"/>
            <action id="VerilogToolbox.Quartus.Program"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusProgramAction"
                    text="Program Device"
                    description="Program the device with the file of the last compilation"
                    icon="AllIcons.Actions.Download"/>
            <action id="VerilogToolbox.Quartus.CompileAndProgram"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusCompileAndProgramAction"
                    text="Compile Design and Program Device"
                    description="Compile the Quartus Prime project and, if that succeeds, program the device"
                    icon="AllIcons.Actions.Execute"/>
            <group id="VerilogToolbox.Quartus.Steps" text="Run Step" popup="true" icon="AllIcons.Actions.More"
                   description="Run one step of the compilation again">
                <action id="VerilogToolbox.Quartus.Synthesize"
                        class="com.jotrorox.verilogtoolbox.quartus.QuartusSynthesizeAction"
                        text="Analysis &amp;&amp; Synthesis"
                        description="Synthesize the design"/>
                <action id="VerilogToolbox.Quartus.Fit"
                        class="com.jotrorox.verilogtoolbox.quartus.QuartusFitAction"
                        text="Fitter (Place &amp;&amp; Route)"
                        description="Place and route the synthesized design"/>
                <action id="VerilogToolbox.Quartus.Assemble"
                        class="com.jotrorox.verilogtoolbox.quartus.QuartusAssembleAction"
                        text="Assembler (Generate Programming Files)"
                        description="Write the programming files of the fitted design"/>
                <action id="VerilogToolbox.Quartus.Timing"
                        class="com.jotrorox.verilogtoolbox.quartus.QuartusTimingAction"
                        text="Timing Analysis"
                        description="Analyze the timing of the fitted design, after a change to the constraints"/>
            </group>
            <separator/>
            <action id="VerilogToolbox.Quartus.ShowOverview"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusShowOverviewAction"
                    text="Compilation Overview"
                    description="Show the device, the last compilation, its timing and its resources in the Quartus tool window"/>
            <action id="VerilogToolbox.Quartus.ShowPins"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusShowPinsAction"
                    text="Pin Assignments"
                    description="Assign the ports of the top-level entity to pins and I/O standards in the Quartus tool window"/>
            <action id="VerilogToolbox.Quartus.ShowMessages"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusShowMessagesAction"
                    text="Messages"
                    description="Show the errors and warnings of the last compilation in the Quartus tool window"/>
            <group id="VerilogToolbox.Quartus.Reports"
                   class="com.jotrorox.verilogtoolbox.quartus.QuartusReportsGroup"
                   text="Reports" popup="true" icon="AllIcons.Actions.ListFiles"
                   description="Open a report of the last compilation"/>
            <action id="VerilogToolbox.Quartus.ChangeDevice"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusChangeDeviceAction"
                    text="Device…"
                    description="Choose the device family and the device the project is compiled for"/>
            <action id="VerilogToolbox.Quartus.OpenSettings"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusOpenSettingsAction"
                    text="Open Settings File"
                    description="Open the .qsf file of the revision, which holds every assignment"
                    icon="AllIcons.General.Settings"/>
            <action id="VerilogToolbox.Quartus.OpenInQuartus"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusOpenInQuartusAction"
                    text="Open in Quartus Prime"
                    description="Open the project in Quartus Prime itself"
                    icon="AllIcons.Ide.External_link_arrow"/>
            <action id="VerilogToolbox.Quartus.Refresh"
                    class="com.jotrorox.verilogtoolbox.quartus.QuartusRefreshAction"
                    text="Refresh"
                    description="Look for Quartus project files and reports again"
                    icon="AllIcons.Actions.Refresh"/>
        </group>
        <!-- The toolbar of the Quartus tool window. -->
        <group id="VerilogToolbox.Quartus.Toolbar">
            <reference ref="VerilogToolbox.Quartus.Analyze"/>
            <reference ref="VerilogToolbox.Quartus.Compile"/>
            <reference ref="VerilogToolbox.Quartus.Program"/>
            <reference ref="VerilogToolbox.Quartus.CompileAndProgram"/>
            <reference ref="VerilogToolbox.Quartus.Steps"/>
            <separator/>
            <reference ref="VerilogToolbox.Quartus.Reports"/>
            <reference ref="VerilogToolbox.Quartus.OpenSettings"/>
            <reference ref="VerilogToolbox.Quartus.OpenInQuartus"/>
            <reference ref="VerilogToolbox.Quartus.Refresh"/>
        </group>
        <!-- On files: what belongs to the Quartus project, and which module is its top level. -->
        <action id="VerilogToolbox.Quartus.AddFile"
                class="com.jotrorox.verilogtoolbox.quartus.QuartusAddFileAction"
                text="Add to Quartus Project"
                description="List this file in the settings file of the Quartus project">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
        <action id="VerilogToolbox.Quartus.RemoveFile"
                class="com.jotrorox.verilogtoolbox.quartus.QuartusRemoveFileAction"
                text="Remove from Quartus Project"
                description="Take this file out of the settings file of the Quartus project">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
        <action id="VerilogToolbox.Quartus.SetTopLevel"
                class="com.jotrorox.verilogtoolbox.quartus.QuartusSetTopLevelAction"
                text="Set as Quartus Top-Level Entity"
                description="Make this module the top-level entity of the Quartus project">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
