<!-- The testbench generator. Included by plugin.xml. -->
<idea-plugin>
    <actions>
        <!-- A testbench skeleton for a module: signals, the instance, clock, reset and a waveform dump. -->
        <action id="VerilogToolbox.GenerateTestbench"
                class="com.jotrorox.verilogtoolbox.testbench.GenerateTestbenchAction"
                text="Generate Testbench"
                description="Create a testbench next to this module that instantiates it, drives its clock and reset, and dumps a waveform">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <!-- A C++ testbench for Verilator: the model, a waveform, clock, reset and a CHECK macro the test tree reads. -->
        <action id="VerilogToolbox.GenerateVerilatorCppTestbench"
                class="com.jotrorox.verilogtoolbox.testbench.GenerateVerilatorCppTestbenchAction"
                text="Generate Verilator C++ Testbench"
                description="Create a C++ testbench next to this module that drives its Verilated model, dumps a waveform and checks it">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
